# ══════════════════════════════════════════════════════════════════
# Claude Code SEO Décupler — variables d'environnement
# ══════════════════════════════════════════════════════════════════
#
# Copiez ce fichier à la racine du projet sous le nom `.env`.
# Ne remplissez QUE ce dont vous avez besoin : chaque MCP est optionnel,
# les skills s'adaptent à ce qui est branché et vous disent ce qui manque.
#
#   cp config/.env.example .env
#   /seo doctor          ← vous dit qui répond et qui manque
#
# ⚠️  `.env` et `secrets/` sont dans .gitignore. Ne les commitez jamais.
# ══════════════════════════════════════════════════════════════════


# ─── NIVEAU 1 : le minimum vital (gratuit) ────────────────────────
# Avec ces deux-là seuls, vous avez déjà 70 % de la valeur du dispositif.

# Google Search Console — la source de vérité de vos performances
# Google Cloud Console → activer "Search Console API" → compte de service
# → clé JSON → déposer dans ./secrets/ → ajouter l'email du compte de
# service comme utilisateur en LECTURE SEULE dans Search Console.
# Ne donnez JAMAIS le rôle propriétaire à un compte de service.
GSC_SITE_URL=https://votre-site.com/
# Deux façons de fournir la clé du compte de service, au choix :
#  - le chemin du fichier (poste local) :
GSC_CREDENTIALS_JSON=./secrets/gsc-service-account.json
#  - ou son contenu, JSON ou base64 (routines cloud, secrets d'environnement) :
# GSC_SA_JSON=

# Google Analytics 4 — relier le SEO au chiffre d'affaires
# Google Cloud Console → activer "Google Analytics Data API"
# → même compte de service → ajouter en Lecteur sur la propriété GA4
GA4_PROPERTY_ID=
GA4_CREDENTIALS_JSON=./secrets/ga4-service-account.json


# ─── NIVEAU 2 : la donnée marché (payant, mais décisif) ───────────

# DataForSEO — volumes, difficulté, SERP live. Le meilleur rapport
# qualité/prix du marché (paiement à la requête, pas d'abonnement).
# https://app.dataforseo.com/api-access
# Nom officiel : DATAFORSEO_LOGIN. Renseignez aussi DATAFORSEO_USERNAME (même valeur)
# si vous utilisez le MCP DataForSEO, qui lit ce nom-là. scripts/demande.py lit les deux.
DATAFORSEO_LOGIN=
DATAFORSEO_USERNAME=
DATAFORSEO_PASSWORD=

# Ahrefs — backlinks et autorité. Nécessite un plan avec accès API.
# https://ahrefs.com/api
AHREFS_API_KEY=

# Semrush — mots-clés concurrents et gaps.
# https://www.semrush.com/api-analytics/
SEMRUSH_API_KEY=

# Ubersuggest — expansion de mots-clés.
# Astuce : disponible en connecteur claude.ai (un clic, pas de clé).
UBERSUGGEST_API_KEY=


# ─── NIVEAU 3 : lecture du web ────────────────────────────────────

# Firecrawl — scrape propre en markdown, JS rendu inclus.
# Offre gratuite généreuse : https://firecrawl.dev
FIRECRAWL_API_KEY=

# Chrome DevTools — aucune clé requise, tourne en local.
# Nécessite simplement Node et Chrome installés sur la machine.


# ─── NIVEAU 4 : publication ───────────────────────────────────────

# WordPress — API REST. Créez un "mot de passe d'application"
# (Utilisateurs → Profil → Mots de passe d'application),
# jamais votre mot de passe de connexion. Utilisé par scripts/wp.py
# (WP_USERNAME reste accepté pour les anciennes configurations).
WP_SITE_URL=https://votre-site.com
WP_USER=
WP_APP_PASSWORD=

# Webflow — Site settings → Apps & integrations → API access
WEBFLOW_TOKEN=
WEBFLOW_SITE_ID=


# ─── NIVEAU 5 : pilotage et visibilité IA ─────────────────────────

# Notion — pilotage : leads, objectifs, roadmap, briefs, backlinks.
# Recommandé : le connecteur natif claude.ai (aucune clé nécessaire).
# Sinon : https://www.notion.so/my-integrations
NOTION_TOKEN=

# Moteurs IA — part de voix mesurée par share_of_model.py, recherche web
# activée. OpenAI et Gemini suffisent ; les autres sont facultatifs.
# https://platform.openai.com/api-keys · https://aistudio.google.com/apikey
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
PERPLEXITY_API_KEY=
# Génération d'images (images_generer.py) : mêmes clés Gemini / OpenAI.
# Modèles facultatifs, sinon ceux par défaut du script.
IMAGES_MODELE_GEMINI=
IMAGES_MODELE_OPENAI=

# Reddit — questions et vocabulaire de l'audience
# https://www.reddit.com/prefs/apps → create app (type: script)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Treg — routeur d'outils payés à l'appel (MCP « treg »). https://treg.to
# Monid se connecte par OAuth (/mcp → monid → Authenticate) : rien à mettre ici.
TREG_TOKEN=

# Pangram — détecteur d'IA, mesure facultative après seo-humanisation
# (pangram.py). https://www.pangram.com → tableau de bord → API
PANGRAM_API_KEY=

# YouTube — veille vidéo (youtube.py). Aucune clé. Proxy facultatif quand
# YouTube refuse les sous-titres à un serveur : http://user:mdp@hote:port
YOUTUBE_PROXY_URL=


# ─── GARDE-FOUS ───────────────────────────────────────────────────

# Kill-switch global. Mettez 1 pour forcer le mode sûr partout :
# plus aucune écriture externe, tout devient brouillon ou proposition.
# Prend le pas sur tout ce que dit config/decupler-seo.config.yml.
SEO_SAFE_MODE=0

# Domaines sur lesquels l'écriture est autorisée (séparés par des virgules).
# Vide = seul le domaine de GSC_SITE_URL est autorisé.
SEO_ALLOWED_DOMAINS=
