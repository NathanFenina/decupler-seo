# Clés de ce projet. Copiez en .env (jamais commité).
# Dans une routine, déclarez-les dans l'environnement cloud, pas ici.
GSC_SITE_URL={{DOMAINE}}/
SEO_ALLOWED_DOMAINS={{DOMAINE_NU}}
SEO_SAFE_MODE=0
# Clé IndexNow (Bing, et donc la recherche ChatGPT) — publiez aussi <clé>.txt à la racine du site
INDEXNOW_KEY=
# WordPress (facultatif) — publication par wp.py, en brouillon par défaut.
# Mot de passe d'application : Utilisateurs → Profil → Mots de passe d'application.
WP_SITE_URL=
WP_USER=
WP_APP_PASSWORD=
